# IBM watsonx.ai Credentials
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your IBM Cloud API Key
# Get it from: https://cloud.ibm.com → Manage → Access (IAM) → API Keys
WATSONX_APIKEY=Fu0L4BgPo6Za84gcQEJ0E_fVpZ8634nQuERjPGDi9Vaf

# Your watsonx.ai Project ID
# Get it from: watsonx.ai → Your Project → Manage tab → General → Project ID
WATSONX_PROJECT_ID=cfcd3767-e488-4ccc-9993-5145d867bafb

# watsonx.ai regional endpoint URL
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-de.ml.cloud.ibm.com
#          https://jp-tok.ml.cloud.ibm.com
#          https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
